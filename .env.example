# Copiá este archivo como ".env" (que está en .gitignore) y completá los valores.
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux/macOS/Git Bash:  cp .env.example .env

# Credenciales de las 5 bases PostgreSQL (cada servicio tiene su propia instancia).
# Son solo para tu entorno local: elegí una contraseña propia.
DB_USERNAME=consultorio
DB_PASSWORD=cambiar_esta_clave_local

# Inicio de sesión (JWT). La clave firma los tokens: al menos 32 caracteres aleatorios.
# Generá una con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRETO=reemplazar_por_una_clave_aleatoria_de_al_menos_32_caracteres
# Usuario administrativo que se crea automáticamente la PRIMERA vez que inicia paciente-service.
ADMIN_USUARIO=admin
ADMIN_CLAVE=cambiar_esta_clave_admin

# Modelo de Ollama que usa el asistente (se descarga con el perfil "ia").
OLLAMA_MODEL=llama3.2:3b

# Dónde está Ollama, visto desde el contenedor consulta-service:
#  - Ollama dentro de Docker Compose (perfil "ia"):  http://ollama:11434
#  - Ollama instalado en Windows (fuera de Docker):  http://host.docker.internal:11434
OLLAMA_BASE_URL=http://ollama:11434
